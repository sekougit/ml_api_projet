    "import requests\n",
    "\n",
    "url = \"https://ml-api-projet.onrender.com/predict\"\n",
    "\n",
    "payload = {\n",
    "    \"sepal_length\":5.1,\n",
    "    \"sepal_width\":3.5,\n",
    "    \"petal_length\":1.4,\n",
    "    \"petal_width\":0.2\n",
    "}\n",
    "\n",
    "response = requests.post(\n",
    "    url,\n",
    "    json=payload\n",
    ")\n",
    "\n",
    "print(response.json())"
   ]
  }
